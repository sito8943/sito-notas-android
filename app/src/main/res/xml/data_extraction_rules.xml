<?xml version="1.0" encoding="utf-8"?>
<!-- Backup deshabilitado: las notas sin sincronizar y la sesion cifrada no
     deben salir del dispositivo sin una politica de backup cifrado. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
